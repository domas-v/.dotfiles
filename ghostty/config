# alt
macos-option-as-alt = true

# font
font-family = "Maple Mono NF"
font-size = 16

# color theme
theme = dark:Kanagawa Wave,light:Kanagawa Lotus

# background-opacity = 0.70
# background-blur = true

# cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# title bar
macos-titlebar-style = transparent
window-new-tab-position = end

# --- TMUX --- 
config-file = tmux.config
# if no tmux
# config-file = keybindings.config
# config-file = vim.config

# --- KEYBINDS --- 

# global dropdown terminal
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-animation-duration = 0

# terminal search
keybind = cmd+f=start_search

# command palette
keybind = cmd+shift+;=toggle_command_palette

